# PM Store — Backend environment variables
# Copy this file to ".env" and fill in real values before deploying.
# Never commit the .env file.

# --- Core ---
PORT=4000
NODE_ENV=development

# JWT auth — generate a strong random secret:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-random-48-byte-hex-string
JWT_EXPIRES_IN=8h

# First admin account — set ADMIN_EMAIL and either a bcrypt hash OR a plain
# ADMIN_PASSWORD (seeded on first boot; more admins can be added from the
# admin panel > Staff). Generate a hash:
#   node -e "console.log(require('bcryptjs').hashSync('your-password-here', 12))"
ADMIN_EMAIL=admin@pmstore.com
ADMIN_PASSWORD_HASH=replace-with-bcrypt-hash
# ADMIN_PASSWORD=your-plain-password  # alternative to the hash above

# --- Persistence (JSON file storage; swap for Postgres/Mongo at scale) ---
# DATA_FILE=data.json
# UPLOAD_DIR=uploads

# --- CORS / security ---
# Comma-separated list of origins allowed to call the API.
# In production, use your real domains only — never '*'.
# Example: ALLOWED_ORIGINS=https://pmstore.com,https://admin.pmstore.com
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# --- Rate limiting (login brute-force protection) ---
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX=20
